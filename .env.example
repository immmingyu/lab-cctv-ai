LLM_PROVIDER=ollama
LLM_MODEL=exaone3.5:7.8b

# Claude로 전환할 때:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=

CAMERA_INDEX=0
YOLO_DEVICE=
LLM_PROVIDER=ollama
LLM_MODEL=exaone3.5:7.8b

# 조건부 VLM (로컬 Ollama 비전 모델)
# RTX 3060 12GB: LLM(exaone 4.8GB) + YOLO와 같이 올리려면 4b, 단독이면 8b도 가능
VLM_MODEL=qwen3-vl:4b-instruct

# (선택) HIGH 이벤트를 Discord로 알림. 비워두면 기능이 꺼짐. 텍스트만 전송, 스냅샷은 보내지 않음
DISCORD_WEBHOOK_URL=
# (선택, 전시회용) Discord로 보낼 종류. 비워두면 예전처럼 HIGH만, 간격 제한 없음
# 쓸 수 있는 이름: fall_high, fall_medium, restricted_area_intrusion, object_displacement
# 값을 넣으면 같은 종류는 DISCORD_NOTIFY_COOLDOWN_SECONDS(기본 60초)에 한 번만 보냄
DISCORD_NOTIFY_TYPES=
# DISCORD_NOTIFY_TYPES=fall_high,restricted_area_intrusion,object_displacement
DISCORD_NOTIFY_COOLDOWN_SECONDS=60

# (선택, 전시회용) 대시보드 알림 기본값. 1이면 켜짐, 비워두면 꺼짐(예전과 같음). 대시보드 위쪽 체크박스로도 켜고 끌 수 있음
DASHBOARD_EXTRA_SOUND=
DASHBOARD_LOW_BANNER=

# 물건 검출 모델 (한 줄로 교체). 파인튜닝 모델은 weights 폴더의 thresholds.json 확신도 기준을 같이 씀
OBJECT_MODEL=yolov8s.pt
# OBJECT_MODEL=runs/finetune/book_laptop_v1/weights/best.pt
